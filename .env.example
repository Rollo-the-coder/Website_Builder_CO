# Safe placeholders only. Copy to a local .env.local file and fill real values there.
# Never commit real secrets. .env files are gitignored except this example.

# Public base URL of the deployed site (used for SEO metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://gotta.build

# Analytics-ready: set a measurement ID to enable analytics. Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_ID=

# Contact form mode:
# - demo: accept submissions but do not email (safe for local/preview demos)
# - live: require full delivery env and send emails
# If unset, Vercel production defaults to live; local/preview defaults to demo.
CONTACT_FORM_MODE=

# Contact form email delivery (Postmark — Gotta Build server).
# Production requires the server token + from address confirmed in Postmark.
# CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL fall back to erik@gotta.build in code.
POSTMARK_SERVER_TOKEN=
CONTACT_TO_EMAIL=erik@gotta.build
# Must be a confirmed Postmark Sender Signature on gotta.build.
CONTACT_FROM_EMAIL=erik@gotta.build
