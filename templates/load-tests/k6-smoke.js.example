// Example only — adapt before use.
// k6 smoke test for homepage, contact page, and one API route placeholder.
// Run against staging, not production:
//   k6 run templates/load-tests/k6-smoke.js.example -e BASE_URL=https://staging.example.com

import http from 'k6/http';
import { check, sleep } from 'k6';

export const options = {
  vus: 5,
  duration: '30s',
  thresholds: {
    http_req_failed: ['rate<0.01'],
    http_req_duration: ['p(95)<2000'],
  },
};

const BASE_URL = __ENV.BASE_URL || 'http://localhost:3000';

export default function () {
  const home = http.get(`${BASE_URL}/`);
  check(home, {
    'homepage status 200': (r) => r.status === 200,
  });

  const contact = http.get(`${BASE_URL}/contact`);
  check(contact, {
    'contact page status 200': (r) => r.status === 200,
  });

  // Replace with a real health or API route for the project.
  const api = http.get(`${BASE_URL}/api/health`);
  check(api, {
    'api health status 200': (r) => r.status === 200,
  });

  sleep(1);
}
